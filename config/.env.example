# X Configuration
X_EMAIL=your_x_email@example.com
X_USERNAME=your_x_username
X_PASSWORD=your_x_password

# Social Searcher Configuration
SOCIAL_SEARCHER_EMAIL=your_social_searcher_email@example.com
SOCIAL_SEARCHER_PASSWORD=your_social_searcher_password

# Mention Configuration
MENTION_EMAIL=your_mention_email@example.com
MENTION_PASSWORD=your_mention_password

# Email Configuration
# Set EMAIL_PROVIDER to "protonmail" for Proton Mail or "gmail" for Gmail
EMAIL_PROVIDER=protonmail

# For Proton Mail:
# SMTP_SERVER=smtp.protonmail.ch
# SMTP_PORT=587

# For Gmail:
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

SMTP_SERVER=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USERNAME=your-protonmail-address@protonmail.com
SMTP_PASSWORD=your-protonmail-password
SENDER_EMAIL=your-protonmail-address@protonmail.com

# Email notification settings
EMAIL_NOTIFICATION_ENABLED=true
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com
NOTIFY_ON_COLLECTION=false
NOTIFY_ON_PROCESSING=false
NOTIFY_ON_ANALYSIS=true

# Individual to monitor
TARGET_INDIVIDUAL="Sheikh Tamim ibn Hamad Al Thani" 
QUARY_VARIATIONS=["Sheikh Tamim", "Sheikh Tamim Al Thani", "Sheikh Tamim of Qatar", "Sheikh Tamim of Doha", "Sheikh Tamim of Qatar", "Sheikh Tamim of Doha"]